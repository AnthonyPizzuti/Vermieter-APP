{
  "name": "vermieter-app",
  "version": "1.0.0",
  "description": "App zur Verwaltung von Mietern",
  "author": "Janjic",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "clean": "if exist dist rmdir /s /q dist && if exist out rmdir /s /q out",
    "build": "npm run clean && ng build --base-href ./",
    "electron": "npm run build && electron .",
    "make": "npm run build && electron-forge make"
  },
  "private": true,
  "packageManager": "npm@11.10.1",
  "dependencies": {
    "@angular/animations": "^21.1.0",
    "@angular/cdk": "~21.2.1",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "~21.2.1",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/service-worker": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "@electron-forge/cli": "^7.3.0",
    "@electron-forge/maker-zip": "^7.3.0",
    "electron": "^40.8.0",
    "typescript": "~5.9.2"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "VermieterApp",
        "asar": false
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ]
        }
      ]
    }
  }
}